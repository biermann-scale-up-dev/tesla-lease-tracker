# Generate a real password hash and encryption key with npm run setup.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
APP_PASSWORD_HASH=replace-with-generated-scrypt-hash
ENCRYPTION_KEY=replace-with-generated-64-character-hex-key
DATABASE_PATH=data/tracker.sqlite
# Docker deployment: change APP_ORIGIN to https://your-domain and set both DNS records.
APP_DOMAIN=lease.example.com
TELEMETRY_HOST=telemetry.example.com
TELEMETRY_PORT=8443
ACME_EMAIL=you@example.com
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REGION=eu
# These paths apply INSIDE the Docker containers; compose sets them explicitly.
# TESLA_PUBLIC_KEY_PATH=/secrets/command-public.pem
# TESLA_COMMAND_PROXY_URL=https://command-proxy:4443
# TELEMETRY_CA_PATH=/certs/ca.pem
# TELEMETRY_STATUS_URL=http://telemetry:8080/status
# KAFKA_BROKERS=127.0.0.1:19092
